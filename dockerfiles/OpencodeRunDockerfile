FROM node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @opencode/cli@2.1.1

RUN mkdir -p /workspace /volume && chown -R node:node /workspace /volume

USER node
WORKDIR /workspace

CMD ["opencode"]
