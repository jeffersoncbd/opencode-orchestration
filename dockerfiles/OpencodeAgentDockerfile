FROM node:26-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    build-essential \
    curl \
    git \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN npm install -g @opencode/cli@2.1.1

RUN mkdir -p /workspace /volume /tmp/.config/opencode \
    && chown -R node:node /workspace /volume /tmp/.config \
    && chmod 1777 /tmp/.config/opencode

USER node
WORKDIR /workspace

# Porta fixa por decisão de arquitetura: o agente é o único que escuta.
EXPOSE 4096

CMD ["opencode", "serve", "--hostname", "0.0.0.0", "--port", "4096"]
