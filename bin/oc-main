#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=dockercode-config.sh
source "$BIN_DIR/dockercode-config.sh"

base="$(basename "$PWD")"
if ! [[ "$base" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  echo "erro: o nome da pasta '$base' não é válido para o container principal." >&2
  echo "use letras, números, '_', '.' e '-', começando por letra ou número." >&2
  exit 1
fi
name="$base"
if docker container inspect "$name" >/dev/null 2>&1; then
  echo "erro: já existe um container chamado '$name'." >&2
  echo "encerre a outra sessão principal (ou remova o container) e tente de novo." >&2
  exit 1
fi

# Prefixo dos agentes: OC_PROJECT (opcional, padrão = nome da pasta do projeto).
project="${OC_PROJECT:-$base}"
if ! [[ "$project" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]]; then
  echo "erro: OC_PROJECT='$project' não é um prefixo válido." >&2
  echo "use letras, números, '_', '.' e '-', começando por letra ou número." >&2
  exit 1
fi

opts=()
# Mantém o container vivo sem abrir a TUI; `oc-run` abre a interface depois.
cmd=(sleep infinity)
custom_cmd=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --)
      shift
      if [[ $# -gt 0 ]]; then
        cmd=("$@")
        custom_cmd=true
      fi
      break
      ;;
    *) opts+=("$1"); shift ;;
  esac
done

# Imagem: OC_MAIN_IMAGE > .dockercode/image (PWD ou ancestral) > oc-main.
image="$(_dockercode_resolve_image "$PWD" oc-main "${OC_MAIN_IMAGE:-}" image)"

if ! docker image inspect "$image" >/dev/null 2>&1; then
  echo "erro: imagem '$image' não encontrada." >&2
  echo "construa-a e aponte em .dockercode/image (ou OC_MAIN_IMAGE), ou rode ./install.sh para a imagem padrão." >&2
  exit 1
fi

# Monta os itens de ~/.config/dockercode (plugins, lib, agents, ...) e a
# configuração do usuário em /tmp/.config/opencode. Montar item a item evita
# binds aninhados: um arquivo de config fora da pasta não cria mount points no host.
config_mount=()
config_root="$HOME/.config/dockercode"
if [[ -d "$config_root" ]]; then
  config_root="$(cd "$config_root" && pwd -P)"
  shopt -s nullglob dotglob
  for entry in "$config_root"/*; do
    entry_name="$(basename "$entry")"
    case "$entry_name" in
      opencode.json | opencode.jsonc) continue ;;
    esac
    config_mount+=(-v "$entry:/tmp/.config/opencode/$entry_name")
  done
  shopt -u nullglob dotglob
fi

user_config_mount=()
for config_file in ${USER_CONFIGS[@]+"${USER_CONFIGS[@]}"}; do
  user_config_mount+=(-v "$config_file:/tmp/.config/opencode/$(basename "$config_file")")
done

if [[ ${#USER_CONFIGS[@]} -gt 0 ]]; then
  echo "config do usuário: ${USER_CONFIGS[*]}" >&2
elif ! _dockercode_has_project_config "$PWD"; then
  echo "aviso: nenhum opencode.json encontrado no projeto nem em '${USER_CONFIG_DIR:-$HOME/.config/dockercode}'." >&2
fi

password_env=()
if [[ -f "$HOME/.config/dockercode/agent-password" ]]; then
  password_env=(-e "OPENCODE_AGENT_PASSWORD=$(cat "$HOME/.config/dockercode/agent-password")")
fi

echo "imagem: $image" >&2
echo "prefixo dos agentes: $project" >&2
if [[ "$custom_cmd" == true ]]; then
  echo "comando customizado: ${cmd[*]}" >&2
fi

docker run -d --rm \
  --init \
  --name "$name" \
  -u "$(id -u):$(id -g)" \
  -e HOME=/tmp \
  -e "OC_PROJECT=$project" \
  -v "$PWD":/workspace \
  ${config_mount[@]+"${config_mount[@]}"} \
  ${user_config_mount[@]+"${user_config_mount[@]}"} \
  ${password_env[@]+"${password_env[@]}"} \
  -e OPENCODE_API_KEY \
  ${opts[@]+"${opts[@]}"} \
  "$image" \
  ${cmd[@]+"${cmd[@]}"} >/dev/null

if ! docker inspect -f '{{.State.Running}}' "$name" 2>/dev/null | grep -q '^true$'; then
  echo "erro: o container '$name' não ficou em execução." >&2
  echo "--- docker logs --tail 50 $name ---" >&2
  docker logs --tail 50 "$name" >&2 || true
  exit 1
fi

if [[ "$custom_cmd" == true ]]; then
  echo "container '$name' iniciado em background com comando customizado (imagem: $image; logs: docker logs -f $name)"
else
  echo "container '$name' iniciado em background (imagem: $image)."
  echo "abra a interface com: oc-run"
fi
